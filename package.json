{
  "name": "extension-manager",
  "version": "0.3.3",
  "description": "A Chrome extension to manage other extensions",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --loader ts-node/esm node_modules/webpack/bin/webpack.js --config webpack.config.ts --mode=development --watch",
    "build": "NODE_ENV=production node --loader ts-node/esm node_modules/webpack/bin/webpack.js --config webpack.config.ts --mode=production",
    "start": "NODE_ENV=development node --loader ts-node/esm node_modules/webpack/bin/webpack.js --config webpack.config.ts --mode=development",
    "prettier-check": "prettier --config prettier.config.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json}\"",
    "prettier-fix": "prettier --config prettier.config.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json}\"",
    "eslint-check": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "eslint-fix": "eslint --fix \"src/**/*.{ts,tsx,js,jsx}\"",
    "type-check": "tsc --noEmit",
    "clean-install-modules": "rm -rf node_modules && pnpm install"
  },
  "keywords": [
    "chrome-extension",
    "extension-manager",
    "typescript",
    "react"
  ],
  "author": "Kojiro Futamura",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@types/react-window": "^1.8.8",
    "consola": "^3.4.2",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-window": "^1.8.11",
    "tslog": "^4.11.0",
    "uuid": "^11.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/chrome": "^0.0.329",
    "@types/html-webpack-plugin": "^3.2.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "4.3.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
